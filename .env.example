FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
DB_PATH=monitoring.db
SOCKETIO_ASYNC_MODE=eventlet
MAX_CONTENT_LENGTH=16777216

# --- Production (Vercel + Neon) ---
